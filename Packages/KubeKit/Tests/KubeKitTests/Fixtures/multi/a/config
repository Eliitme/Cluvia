apiVersion: v1
kind: Config
current-context: shared-ctx
clusters:
- name: shared
  cluster:
    server: https://a.example:6443
    certificate-authority: certs/ca.pem
    tls-server-name: api.internal
- name: only-a
  cluster:
    server: https://only-a.example
    insecure-skip-tls-verify: true
    proxy-url: socks5://127.0.0.1:1080
users:
- name: shared-user
  user:
    client-certificate: certs/client.crt
    client-key: /abs/client.key
    tokenFile: token
- name: exec-user
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1
      command: ./bin/plugin
      args: ["--flag"]
      env:
      - name: PROFILE
        value: dev
      provideClusterInfo: true
      interactiveMode: Never
- name: bare-exec-user
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
contexts:
- name: shared-ctx
  context:
    cluster: shared
    user: shared-user
    namespace: team-a
- name: a-only
  context:
    cluster: only-a
    user: exec-user
